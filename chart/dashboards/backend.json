      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (service) (openprime_db_pool_pending_acquires{namespace=\"$namespace\", service=~\"$api_service|$worker_service\"})",
          "editorMode": "code",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false
