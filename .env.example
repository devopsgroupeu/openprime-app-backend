# OpenPrime Backend — environment variables
# Copy to `.env` and fill in. Do NOT commit your real `.env`.

# --- Server ---
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Logging ---
LOG_LEVEL=info
# Transport is auto-detected (console-only in Kubernetes). Override if needed:
# CONSOLE_LOGGING=true
# FILE_LOGGING=false

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=openprime
DB_USER=openprime
DB_PASSWORD=change-me

# --- Keycloak (auth) ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=openprime
# Comma-separated list of accepted JWT issuers (e.g. internal + public URLs)
KEYCLOAK_JWT_ISSUERS=http://localhost:8080/realms/openprime

# --- Credential encryption ---
# 32-byte key as 64 hex chars:  openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=replace-with-64-hex-chars

# --- Internal services ---
INJECTO_SERVICE_URL=http://localhost:8000
STATECRAFT_SERVICE_URL=http://localhost:8001

# --- Infrastructure templates (repo Injecto pulls to generate IaC) ---
INFRA_TEMPLATES_REPO_URL=https://github.com/devopsgroupeu/openprime-infra-templates.git
INFRA_TEMPLATES_BRANCH=main

# Wizard catalog, proxied from Injecto's /catalog. TTL is how long a fetched
# document is served without revalidating; the stale window is how long an old
# one may still be served while Injecto is unreachable.
CATALOG_CACHE_TTL_MS=300000
CATALOG_STALE_MAX_MS=86400000

# --- Async job worker (generate/push) ---
# In-process worker polls the DB-backed jobs table. Set WORKER_ENABLED=false
# when running a dedicated worker process instead.
WORKER_ENABLED=true
JOB_POLL_INTERVAL_MS=3000
# Concurrency caps protect Injecto/StateCraft/Bedrock from saturation.
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_GENERATE=2
MAX_CONCURRENT_PUSH=1
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_DELAY_MS=5000
JOB_RETRY_MAX_DELAY_MS=300000
JOB_DEADLINE_MS=600000
JOB_DRAIN_TIMEOUT_MS=30000
# Where generated ZIP artifacts are persisted (mounted PVC in Kubernetes).
UPLOADS_DIR=uploads

# --- AI assistant (AWS Bedrock) ---
AWS_REGION=eu-west-1
BEDROCK_INFERENCE_PROFILE_ARN=

# --- Kubernetes (auto-set in-cluster; leave unset locally) ---
# KUBERNETES_SERVICE_HOST=

# --- TLS (dev only; NEVER enable in production) ---
# NODE_TLS_REJECT_UNAUTHORIZED=0
